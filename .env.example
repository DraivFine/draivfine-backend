# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- Base de données (PostgreSQL / TimescaleDB) ---
DATABASE_URL=postgresql://moto_safety:changeme@localhost:5432/moto_safety?schema=public

# --- Redis (cache, sessions actives, BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth (dashboard gestionnaires/admin) ---
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h

# --- Microservice ML de scoring (FastAPI) ---
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_MS=5000
# Si le service ML est indisponible, on retombe sur les règles heuristiques
SCORING_FALLBACK_TO_HEURISTICS=true

# --- Notifications SMS d'urgence ---
SMS_PROVIDER=twilio
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Africa's Talking (alternative / fallback régional)
AT_API_KEY=
AT_USERNAME=
AT_FROM_SHORTCODE=

# --- Firebase Cloud Messaging (push) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Mobile Money (abonnements) ---
MOMO_API_KEY=
MOMO_API_USER=
MOMO_SUBSCRIPTION_KEY=
MOMO_TARGET_ENV=sandbox
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
